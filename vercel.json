{
  "version": 2,
  "rewrites": [
    { "source": "/", "destination": "/api/home" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/robots.txt", "destination": "/api/robots" },
    { "source": "/widget", "destination": "/api/widget" },
    { "source": "/terms", "destination": "/api/terms" },
    { "source": "/privacy", "destination": "/api/privacy" },
    { "source": "/api/feed", "destination": "/api/feed" },
    { "source": "/api/click", "destination": "/api/click" },
    { "source": "/api/weather", "destination": "/api/weather" },
    { "source": "/api/route", "destination": "/api/route" },
    { "source": "/api/events/:id", "destination": "/api/admin-api?id=:id" },
    { "source": "/event/:id", "destination": "/api/event?id=:id" },
    { "source": "/og/event/:id.png", "destination": "/api/og?id=:id" },
    { "source": "/admin", "destination": "/api/admin" },
    { "source": "/:city(denver|boulder|golden|aurora)", "destination": "/api/landing" },
    { "source": "/:city(denver|boulder|golden|aurora)/:topic", "destination": "/api/landing" },
    { "source": "/(.*)", "destination": "/api/router" }
  ],
  "functions": {
    "api/home.js": { "maxDuration": 30 },
    "api/router.js": { "maxDuration": 30 },
    "api/landing.js": { "maxDuration": 30 },
    "api/sitemap.js": { "maxDuration": 30 },
    "api/robots.js": { "maxDuration": 30 },
    "api/index.js": { "maxDuration": 30 },
    "api/feed.js": { "maxDuration": 30 },
    "api/click.js": { "maxDuration": 30 },
    "api/weather.js": { "maxDuration": 30 },
    "api/route.js": { "maxDuration": 30 },
    "api/event.js": { "maxDuration": 30 },
    "api/widget.js": { "maxDuration": 30 },
    "api/terms.js": { "maxDuration": 30 },
    "api/privacy.js": { "maxDuration": 30 },
    "api/admin-api.js": { "maxDuration": 30 },
    "api/admin.js": { "maxDuration": 30 },
    "api/og.js": { "maxDuration": 30 }
  }
}
